+class PinnedUrlData : public base::SupportsUserData::Data {
+ public:
+  static constexpr char kKey[] = "helium.pinned_tab_url";
+
+  explicit PinnedUrlData(GURL url) : url_(std::move(url)) {}
+
+  static const GURL* Get(content::WebContents* contents) {
+    auto* data = static_cast<PinnedUrlData*>(contents->GetUserData(kKey));
+    return data ? &data->url_ : nullptr;
+  }
+
+  static void Sync(tabs::TabInterface* tab) {
+    content::WebContents* contents = tab->GetContents();
+    if (!tab->IsPinned()) {
+      contents->RemoveUserData(kKey);
+      return;
+    }
+
+    if (Get(contents)) {
+      return;
+    }
+
+    content::NavigationEntry* entry =
+        contents->GetController().GetLastCommittedEntry();
+    const GURL url = entry ? entry->GetURL() : contents->GetVisibleURL();
+    contents->SetUserData(kKey, std::make_unique<PinnedUrlData>(url));
+  }
+
+ private:
+  GURL url_;
+};
+
